{
  "name": "kiyo-plays",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "probe": "node --experimental-strip-types scripts/probe-mapping.ts",
    "probe:mapping": "node --experimental-strip-types scripts/probe-mapping.ts",
    "probe:idle": "node --experimental-strip-types scripts/probe-idle.ts",
    "probe:shake": "node --experimental-strip-types scripts/probe-shake.ts",
    "probe:synth-shake": "node --experimental-strip-types scripts/probe-synth-shake.ts",
    "probe:slow": "node --experimental-strip-types scripts/probe-slow.ts",
    "probe:fullscreen": "node --experimental-strip-types --import ./scripts/dir-import-hook.mjs scripts/probe-fullscreen.ts",
    "probe:gestures": "node --experimental-strip-types --import ./scripts/dir-import-hook.mjs scripts/probe-gestures.ts",
    "probe:session": "node --experimental-strip-types --import ./scripts/dir-import-hook.mjs scripts/probe-session.ts",
    "probe:haptics": "node --experimental-strip-types scripts/probe-haptics.ts",
    "probe:emitter": "node --experimental-strip-types scripts/probe-emitter.ts",
    "probe:hover": "node --experimental-strip-types scripts/probe-hover.ts",
    "probe:keyboard": "node --experimental-strip-types scripts/probe-keyboard.ts",
    "probe:chips": "node --experimental-strip-types scripts/probe-chips.ts",
    "probe:raise-camera": "node --experimental-strip-types scripts/probe-raise-camera.ts",
    "probe:origin": "node --experimental-strip-types scripts/probe-origin.ts",
    "probe:composite": "node --experimental-strip-types scripts/probe-composite.ts",
    "probe:nudge": "node --experimental-strip-types scripts/probe-nudge.ts",
    "probe:touches": "node --experimental-strip-types scripts/probe-touches.ts",
    "probe:touch-stream": "node --experimental-strip-types scripts/probe-touch-stream.ts",
    "probe:ripples": "node --experimental-strip-types scripts/probe-ripples.ts",
    "probe:motion-bias": "node --experimental-strip-types scripts/probe-motion-bias.ts",
    "probe:sky": "node --experimental-strip-types scripts/probe-sky.ts",
    "probe:moon": "node --experimental-strip-types scripts/probe-moon.ts",
    "probe:tap": "node --experimental-strip-types scripts/probe-tap.ts",
    "probe:rgb-slip": "node --experimental-strip-types scripts/probe-rgb-slip.ts",
    "probe:posture": "node --experimental-strip-types scripts/probe-posture.ts",
    "probe:camera-arm": "node --experimental-strip-types scripts/probe-camera-arm.ts",
    "probe:ambient-light": "node --experimental-strip-types scripts/probe-ambient-light.ts",
    "probe:name-decode": "node --experimental-strip-types scripts/probe-name-decode.ts",
    "probe:celestial": "node --experimental-strip-types scripts/probe-celestial.ts",
    "probe:seed": "node --experimental-strip-types scripts/probe-seed.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^26.4.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7"
  }
}
